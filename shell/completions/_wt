#compdef wt
# Zsh completion for wt (see bin/wt).
#
# Worktree names come from `wt list --names`, which reads git's own worktree
# registry -- so completion covers worktrees created outside wt, and keeps
# working for slugs created under an older WT_SLUG_MAX.

_wt_worktrees() {
    local -a names
    names=(${(f)"$(wt list --names 2>/dev/null)"})
    _describe -t worktrees 'worktree' names
}

_wt_refs() {
    local -a refs
    refs=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)"})
    _describe -t refs 'base ref' refs
}

_wt() {
    local -a commands
    commands=(
        'init:create an orchestration dir (bare clone + local/ state/ main/ wt/)'
        'add:create a worktree'
        'go:cd into a worktree'
        'list:list worktrees for the current project'
        'path:print the worktree'\''s path (default: main)'
        'pull:fetch origin and fast-forward a worktree (default: main)'
        'git:run git in the named worktree (verbatim pass-through)'
        'sync:refresh local/shared into a worktree (default: main)'
        'container:manage the worktree'\''s dev container (host only)'
        'remove:remove a worktree + its containers'
        'prune:clean up stale worktree administrative entries'
        'ignore:write a workspace .ignore so searches skip worktrees'
        'doctor:check layout, git version, pointers, and tooling'
        'help:show help for a command'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'wt command' commands
        return
    fi

    case "${words[2]}" in
        go|path|pull)
            (( CURRENT == 3 )) && _wt_worktrees ;;
        git)
            if (( CURRENT == 3 )); then
                _wt_worktrees
            else
                # Past the name, re-dispatch as a plain git command line so
                # subcommands, flags, and refs complete as after 'git '.
                # Refs are shared repo-wide, so cwd context is correct.
                words=( git "${(@)words[4,-1]}" )
                (( CURRENT -= 2 ))
                _normal
            fi ;;
        container)
            # up|exec, then the name; past that the words belong to the
            # container command.
            if (( CURRENT == 3 )); then
                _values 'container command' \
                    'up[start the dev container (default: main)]' \
                    'exec[run a command in the container]'
            elif (( CURRENT == 4 )); then
                _wt_worktrees
            fi ;;
        sync)
            # Name and flags are order-free; offer whichever remain.
            _alternative \
                'flags:flag:((--all:"sync main plus every worktree" --diff:"preview drift without copying"))' \
                'worktrees:worktree:_wt_worktrees' ;;
        remove)
            if (( CURRENT == 3 )); then
                _alternative 'flags:flag:((--branch:"also delete the branch"))' \
                    'worktrees:worktree:_wt_worktrees'
            else
                _values 'flag' '--branch[also delete the branch]'
            fi ;;
        list)
            _values 'flag' '--names[print bare directory names, one per line]' ;;
        ignore)
            # Target is any workspace directory, not a worktree name.
            _alternative \
                'flags:flag:((--print:"write to stdout instead of the file"))' \
                'dirs:directory:_files -/' ;;
        init)
            (( CURRENT == 4 )) && _files -/ ;;
        add)
            (( CURRENT == 4 )) && _wt_refs ;;
        help)
            _describe -t commands 'wt command' commands ;;
    esac
}

_wt "$@"
